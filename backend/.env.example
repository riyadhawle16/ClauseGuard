# ============================================================
# ClauseGuard Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string.
# For Docker Compose, the hostname is the service name (db).
# For local dev, use localhost.
DATABASE_URL=postgresql://clauseguard:your_db_password@localhost:5432/clauseguard

# ── Authentication ────────────────────────────────────────
# Strong random secret for signing JWTs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Groq LLM ──────────────────────────────────────────────
# Get your API key from https://console.groq.com
# Leave empty to disable LLM features (RAG chat / LLM classification will return fallback responses)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-8b-8192

# ── Embeddings ────────────────────────────────────────────
# sentence-transformers model for semantic search.
# Model is downloaded automatically on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────
# Persistent vector store directory.
# For Docker Compose this is a volume mount path.
CHROMA_PERSIST_DIRECTORY=./chroma_data

# ── File Storage ──────────────────────────────────────────
# Directory where uploaded PDFs are stored.
UPLOAD_DIR=uploads

# ── Application ───────────────────────────────────────────
# Maximum PDF upload size in megabytes.
MAX_FILE_SIZE_MB=20

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
