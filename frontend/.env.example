# ============================================================
# ClauseGuard Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# LOCAL DEVELOPMENT:
#   Leave empty. Vite proxies /api/* to http://localhost:8000 automatically.
#   VITE_API_URL=

# PRODUCTION (Vercel deployment):
#   Set this to your Render backend URL in the Vercel dashboard.
#   DO NOT commit the real URL here.
#   VITE_API_URL=https://your-clauseguard-backend.onrender.com

VITE_API_URL=
